# Frontend (build-time, Vite).

# API base URL for split deployments WITHOUT a same-origin proxy, e.g.
# `https://api.example.com/api/v1`. Leave empty for the Vercel beta: axios.ts
# and session.ts then use the relative `/api/v1`, and vercel.json rewrites
# `/api/*` to the Render backend (replace REPLACE_ME_RENDER_HOST there), so the
# browser and the refresh-token cookie stay on one origin.
VITE_API_BASE_URL=

# Explicit WebSocket origin for submission status updates: `wss://<render-host>`
# (e.g. wss://codearena-api.onrender.com). REQUIRED in the Render + Vercel beta
# because Vercel cannot proxy WebSockets — the connection goes straight to
# Render. Leave empty only for same-origin deployments (origin is derived from
# the page: wss:// on HTTPS, ws:// otherwise).
VITE_WS_URL=
