# CodeArena environment template.
# Copy to .env (development) or .env.prod / .env.staging (deployments) and fill in.
# NEVER commit real secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Django core ---
SECRET_KEY=REPLACE-ME-WITH-50-RANDOM-CHARS
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- JWT (backend/apps/users/jwt_utils.py) ---
JWT_ACCESS_SECRET=REPLACE-ME-ACCESS-SECRET-32-CHARS-MIN
JWT_REFRESH_SECRET=REPLACE-ME-REFRESH-SECRET-32-CHARS-MIN

# --- PostgreSQL ---
POSTGRES_DB=polympiad_db
POSTGRES_USER=polympiad_user
POSTGRES_PASSWORD=REPLACE-ME-DB-PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (cache + Celery broker + Channels layer) ---
REDIS_URL=redis://redis:6379/0

# --- Security toggles ---
# Refresh cookie Secure flag (True unless DEBUG). Set False only for HTTP staging.
COOKIE_SECURE=
# Production: force HTTPS redirects (default True in production settings).
SECURE_SSL_REDIRECT=
# Comma-separated origins allowed by CORS in production, e.g. https://codearena.example.com
CORS_ALLOWED_ORIGINS=
# Comma-separated trusted origins for CSRF (scheme included), e.g. https://codearena.example.com
CSRF_TRUSTED_ORIGINS=

# --- TLS / certbot (production rehearsal) ---
DOMAIN=codearena.example.com
SSL_EMAIL=admin@example.com

# --- Frontend (build-time, Vite) ---
# API origin for split deployments (e.g. frontend on Vercel, backend on EC2).
# Leave empty for same-origin deployments (relative /api/v1 behind a proxy).
VITE_API_BASE_URL=
# Optional explicit WebSocket origin for submission status (ws:// or wss://...).
# Leave empty to derive from the page origin automatically (recommended).
# NOTE: for split deployments this MUST point at the backend host explicitly.
VITE_WS_URL=
